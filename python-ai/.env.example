PORT=8000
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHROMA_PERSIST_DIR=./vectorstore
CHROMA_COLLECTION=lawgpt_documents
BACKEND_SERVICE_URL=http://localhost:5000

# Module 5 Phase 3 — case analysis
# LLM provider: "gemini" (needs GEMINI_API_KEY) or "stub" (deterministic
# canned output — lets tests run without an API key).
LLM_PROVIDER=gemini
GEMINI_MODEL=
# English-only ChromaDB retrieval as optional grounding for case analysis.
# Always bypassed when Kannada script is detected in the case text (the
# embedding model is English-oriented). Set to false to disable retrieval.
ANALYSIS_USE_RETRIEVAL=true
ANALYSIS_TOP_K=8

# Module 4 Phase 2 pipeline knobs
OCR_MIN_TEXT_CHARS=25
OCR_RASTER_DPI=200
# Path to the Tesseract OCR binary (pytesseract shells out to it). Set if
# tesseract isn't on PATH, e.g. TESSERACT_CMD=/usr/bin/tesseract
TESSERACT_CMD=tesseract
# Tesseract OCR language(s). Default eng. For Kannada use kan, or kan+eng for
# mixed Kannada+English documents — requires the matching traineddata, installed
# on Ubuntu 24.04 via: sudo apt install tesseract-ocr-kan
# OCR_LANG=kan+eng
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
